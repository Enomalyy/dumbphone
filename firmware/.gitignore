# ESP-IDF build artifacts (generated by `idf.py build`)
build/
sdkconfig
sdkconfig.old
managed_components/
dependencies.lock
compile_commands.json

# Tier-1 desktop build artifacts
build-host/

# LVGL is vendored by `just vendor` at a pinned tag; the tree carries the pin, not the copy.
vendor/lvgl/

# Host-side storage scratch dir (hal_storage writes here) AND the simulator's
# chat data (host/data/chats.json — personal WAHA chats, deliberately not in git).
# A fresh clone therefore starts with an empty chat list; see README "Chat list data".
host/data/
